# Local PostgreSQL user for Docker Compose.
POSTGRES_USER=app

# Local PostgreSQL password for Docker Compose; replace outside source control.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name for Docker Compose.
POSTGRES_DB=app

# Host port mapped to the backend API.
BACKEND_PORT=8080

# Host port mapped to the frontend web app.
FRONTEND_PORT=3000

# Browser-visible backend API URL used by the frontend bundle.
NEXT_PUBLIC_API_URL=http://localhost:8080
